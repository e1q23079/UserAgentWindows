{
    "manifest_version": 3,
    "name": "User Agent Windows",
    "version": "1.0",
    "description": "Change User Agent to Windows",
    "background": {
        "service_worker": "main.js"
    },
    "permissions": [
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}