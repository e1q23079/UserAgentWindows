{
    "manifest_version": 3,
    "name": "User Agent Windows",
    "version": "1.0",
    "description": "Change User Agent to Windows",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "main.js"
            ],
            "run_at": "document_idle",
            "all_frames": true
        }
    ]
}